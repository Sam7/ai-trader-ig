[Unit]
Description=AI Trader worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=6

[Service]
Type=simple
User=ai-trader
Group=ai-trader
WorkingDirectory=/opt/ai-trader/app
ExecStart=/opt/ai-trader/app/Trading.Worker
ExecStopPost=-/opt/ai-trader/bin/capture-worker-exit-evidence.sh
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
MemoryHigh=400M
MemoryMax=480M

Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production
EnvironmentFile=-/etc/ai-trader/ai-trader.env
Environment=MarketData__StorePath=/var/lib/ai-trader/market-data/ig-market-data.sqlite
Environment=MarketData__Recovery__Mode=Disabled
Environment=MarketData__DeploymentContinuity__CheckpointPath=/var/lib/ai-trader/market-data/deployment-continuity/active.json
Environment=MarketData__DeploymentContinuity__ReportDirectory=/var/lib/ai-trader/market-data/deployment-continuity/reports
Environment=MarketData__DeploymentContinuity__ArchiveDirectory=/var/lib/ai-trader/market-data/deployment-continuity/archive
Environment=MarketData__DeploymentContinuity__MaximumGapWindow=00:30:00
Environment=MarketData__DeploymentContinuity__ReadinessTimeout=00:07:00
Environment=MarketData__DeploymentContinuity__RepairTimeout=00:10:00
Environment=MarketData__CloudSnapshot__BucketName=REPLACE_WITH_BACKUP_BUCKET
Environment=MarketData__CloudSnapshot__ObjectName=market-data/ig-market-data.sqlite
Environment=MarketData__CloudSnapshot__Publisher__Enabled=true
Environment=MarketData__CloudSnapshot__Publisher__Interval=00:05:00
Environment=MarketData__CloudSnapshot__Publisher__StagingDirectory=/var/lib/ai-trader/snapshot-publisher
Environment=MarketData__CloudSnapshot__Mirror__Enabled=false
Environment=MarketData__StreamIngestion__DispatcherCapacity=4096
Environment=MarketData__StreamIngestion__BatchSize=250
Environment=MarketData__StreamIngestion__FlushInterval=00:00:01
Environment=MarketData__StreamIngestion__DrainTimeout=00:00:10
Environment=MarketData__StreamIngestion__HealthUpdateThrottle=00:00:30
Environment=AI__Prompts__ObservabilityRootPath=/var/lib/ai-trader/observability
Environment=Automation__Enabled=false
Environment=Automation__IntradayOpportunities__Enabled=false
Environment=Automation__Execution__Mode=Disabled
Environment=WorkerHealth__Enabled=true
Environment=WorkerHealth__Interval=00:01:00
Environment=WorkerHealth__LocalDirectory=/var/lib/ai-trader/health
Environment=WorkerHealth__GcsObjectName=market-data/health/worker-status.json
Environment=WorkerHealth__WarningWorkingSetBytes=314572800
Environment=WorkerHealth__CriticalWorkingSetBytes=377487360
Environment=WorkerHealth__FailFastWorkingSetBytes=440401920
Environment=WorkerHealth__FailFastEnabled=true
Environment=WorkerHealth__CriticalSampleCount=2
Environment=WorkerDiagnostics__Enabled=true
Environment=WorkerDiagnostics__SentryInterval=00:00:01
Environment=WorkerDiagnostics__SampleInterval=00:00:05
Environment=WorkerDiagnostics__FlushInterval=00:00:30
Environment=WorkerDiagnostics__LocalDirectory=/var/lib/ai-trader/diagnostics
Environment=WorkerDiagnostics__SegmentMaximumBytes=8388608
Environment=WorkerDiagnostics__RetentionMaximumBytes=268435456
Environment=WorkerDiagnostics__UploadClosedSegments=true
Environment=WorkerDiagnostics__GcsPrefix=market-data/diagnostics
Environment=WorkerDiagnostics__Containment__Enabled=false
Environment=Alerting__Slack__Enabled=true

StateDirectory=ai-trader
LogsDirectory=ai-trader
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/ai-trader /var/log/ai-trader

[Install]
WantedBy=multi-user.target
